{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "roles", "nextAction", "question", "decision"],
  "properties": {
    "summary": { "type": "string", "maxLength": 560 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "enum": ["designer", "researcher", "developer", "reviewer", "game_designer", "graphic_designer", "copywriter", "marketer"] }
    },
    "nextAction": { "type": "string", "maxLength": 240 },
    "question": { "type": ["string", "null"], "maxLength": 240 },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "title", "recommendation", "tradeoff", "urgency"],
      "properties": {
        "level": { "type": "string", "enum": ["executive", "team"] },
        "title": { "type": "string", "maxLength": 160 },
        "recommendation": { "type": "string", "maxLength": 320 },
        "tradeoff": { "type": "string", "maxLength": 320 },
        "urgency": { "type": "string", "enum": ["now", "today", "when_ready"] }
      }
    }
  }
}
