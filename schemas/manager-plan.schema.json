{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "roles", "nextAction", "question"],
  "properties": {
    "summary": { "type": "string", "maxLength": 560 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "enum": ["designer", "researcher", "developer", "reviewer"] }
    },
    "nextAction": { "type": "string", "maxLength": 240 },
    "question": { "type": ["string", "null"], "maxLength": 240 }
  }
}
